# cp .env.example .env  — npm run dev / npm start จะอ่านให้เอง
# ทุกค่ามี default ที่รันได้อยู่แล้ว ไฟล์นี้คือรายการของที่ "แก้ได้"

# ── เซิร์ฟเวอร์ ──────────────────────────────────────────────────────────────
PORT=4000

# ── Protrack365 (หน้าติดตาม GPS) ─────────────────────────────────────────────
# รหัสผ่านอยู่ตรงนี้ที่เดียว ห้ามหลุดไปฝั่งเบราว์เซอร์
# หน้าเว็บคุยกับ /internal/gps/* เท่านั้น ไม่เคยเห็น password หรือ access token
PROTRACK_BASE=https://api.protrack365.com
PROTRACK_ACCOUNT=DEMO65558
PROTRACK_PASSWORD=DEMO65558

# IMEI ที่จะแสดงเมื่อบัญชีดึง device list ไม่ได้ — คั่นด้วยจุลภาค
# 358069580065558 = GPS Portable WN03D (VT03D) ตัวที่ใช้ทดสอบ
PROTRACK_IMEIS=358069580065558

# auto = ยิงของจริงก่อน พังแล้วค่อยใช้ข้อมูลจำลอง (ขึ้น banner บอกเหตุผลจริง)
# live = ยิงของจริงอย่างเดียว พังก็ขึ้น error ไม่กลบ
# demo = ไม่ยิงออกเน็ตเลย
PROTRACK_MODE=auto

# กัน error 10009 "request too frequent" เวลาเปิดแดชบอร์ดหลายจอพร้อมกัน
PROTRACK_TRACK_CACHE_MS=8000

# ── ต่อกับ relay บน cloud ────────────────────────────────────────────────────
# ปล่อย comment ไว้สำหรับรันในเครื่อง — worker จะ push/pull หา relay ตัวเองที่
# localhost ถ้าเปิดค่าพวกนี้ทั้งที่ยังไม่มี Worker จริง sync จะ error รัว
# ตอนขึ้น VM จริงค่อยเปิดและใส่ค่าให้ตรงกับ wrangler secret เป๊ะ (ดู DEPLOY.md)
# RELAY_BASE=https://tp-relay.yourname.workers.dev
# RELAY_KEY=<ค่าเดียวกับที่ใส่ใน wrangler secret>
# PUSH_EVERY_MS=900000
# PULL_EVERY_MS=15000
# PUSH_CHUNK_SIZE=25

# ── ตารางเวลาของ sync worker ────────────────────────────────────────────────
SYNC_TZ=Asia/Bangkok
WORK_START_HOUR=5
WORK_END_HOUR=21

# ── ความปลอดภัย ─────────────────────────────────────────────────────────────
# ใช้ผสมตอน hash PIN คนขับ — production ต้องเปลี่ยน และต้องตรงกับฝั่ง relay
PIN_PEPPER=dev-pepper-change-me

# LINE channel id สำหรับ verify id token ของคนขับ
# (หน้าคนขับปิดใช้งานอยู่ตอนนี้ — ดู Features.driverApp ใน app/lib/core/features.dart)
LINE_CHANNEL_ID=
